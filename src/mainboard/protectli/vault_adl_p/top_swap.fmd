FLASH 16M {
	SI_ALL@0x0 {
		SI_DESC 4K
		SI_ME 0x4c0000
		SI_DEVICEEXT2 0xbf000
	}
	SI_BIOS@0x580000 0xa80000 {
		SMMSTORE(PRESERVE)@0x0 256K

		UNIFIED_MRC_CACHE(PRESERVE)@0x40000 {
			RECOVERY_MRC_CACHE 128K
			RW_MRC_CACHE 128K
		}

		BOOTSPLASH(CBFS)@0x80000 508K
		FMAP@0xff000 4K

		COREBOOT_TS(CBFS)@0x100000 0x3c0000
		COREBOOT(CBFS)@0x4c0000 0x3c0000

		TOPSWAP(CBFS)@0x880000 1M
		BOOTBLOCK(CBFS)@0x980000 1M
	}
}
