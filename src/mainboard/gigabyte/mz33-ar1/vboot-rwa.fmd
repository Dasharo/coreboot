FLASH 32M {
	# GENOA 16M
	TURIN 16M {
		WP_RO 8M {
			RO_VPD(PRESERVE) 16K
			RO_SECTION {
				FMAP 4K
				RO_FRID 0x100
				RO_FRID_PAD 0x700
				GBB 12K
				COREBOOT(CBFS)
			}
		}

		RW_SECTION_A 6M {
			VBLOCK_A 64K
			FW_MAIN_A(CBFS)
			RW_FWID_A 0x100
		}

		RW_MISC 64K {
			RW_ELOG(PRESERVE) 16K
			RW_SHARED 16K {
				SHARED_DATA 8K
				VBLOCK_DEV 8K
			}
			RW_VPD(PRESERVE) 8K
			RW_NVRAM(PRESERVE) 24K
		}

		BOOTSPLASH(CBFS)

		PSP_SEV_NVRAM 32K
		CONSOLE 128K
		PSP_RPMC_NVRAM(PRESERVE) 256K
		SMMSTORE(PRESERVE) 512K
		RW_MRC_CACHE 832K
	}
}
