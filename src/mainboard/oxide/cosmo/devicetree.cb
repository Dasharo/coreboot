			register "hp_func" = "{
				.i2c_gpio_bit = 0,
				.i2c_gpio_byte_map = 3,
				.i2c_gpio_dev_addr = 0x20,
				.i2c_dev_type = PCA9506,
				.i2c_bus_segment = ApuDirectBus,
				.function_mask = PCIE_HP_FUNC_OOB_PRSNT |
						 PCIE_HP_FUNC_PWREN |
						 PCIE_HP_FUNC_PWRFLT |
						 PCIE_HP_FUNC_ATTNLED |
						 PCIE_HP_FUNC_EMILS,
			}"
			device ref gpp_bridge_5_3_a on end
		end

		# P4 and P5 unused

		device ref gpp_bridge_3_a on
			device ref asp on end
		end
	end

	device domain 6 on
		device ref rcec_6 on end

		# P1 lanes 0-15 (abs 32-47) - Ethernet NIC
		chip drivers/amd/opensil/mpio
			register "type" = "IFTYPE_PCIE"
			register "start_lane" = "32"
			register "end_lane" = "47"
			register "gpio_group" = "1"
			register "speed" = "Gen1"
			register "hotplug" = "ServerExpress"
			register "hotplug_format" = "ExpressModule"
			register "hp_func" = "{
				.i2c_gpio_bit = 0,
				.i2c_gpio_byte_map = 2,
				.i2c_gpio_dev_addr = 0x22,
				.i2c_dev_type = PCA9506,
				.i2c_bus_segment = ApuDirectBus,
				.function_mask = PCIE_HP_FUNC_OOB_PRSNT |
						 PCIE_HP_FUNC_PWREN |
						 PCIE_HP_FUNC_PWRFLT,
			}"
			device ref gpp_bridge_6_0_a on end
		end
	end

	device domain 7 on
		device ref iommu_7 on end
		device ref rcec_7 on end

		# P0 lanes 0-3 (abs 0-3) - Rack switch
		chip drivers/amd/opensil/mpio
			register "type" = "IFTYPE_PCIE"
			register "start_lane" = "0"
			register "end_lane" = "3"
			register "gpio_group" = "1"
			register "speed" = "Gen4"
			register "hotplug" = "ServerExpress"
			register "hotplug_format" = "ExpressModule"
			register "hp_func" = "{
				.i2c_gpio_bit = 0,
				.i2c_gpio_byte_map = 3,
				.i2c_gpio_dev_addr = 0x22,
				.i2c_dev_type = PCA9506,
				.i2c_bus_segment = ApuDirectBus,
				.function_mask = PCIE_HP_FUNC_OOB_PRSNT |
						 PCIE_HP_FUNC_PWRFLT,
			}"
			device ref gpp_bridge_7_0_a on end
		end
	end

	device ref i2c_0 on end
	device ref i2c_1 on end
	device ref i2c_2 on end
	device ref i2c_4 on end
	device ref uart_0 on end
	device ref uart_1 on end
end
