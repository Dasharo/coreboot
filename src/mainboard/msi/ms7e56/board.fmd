FLASH 32M {
	BIOS 16M {
		# The first 64K seem to be omitted by FlashBIOS.
		# To avoid bricks, reserve the first 64K.
		RESERVED 64K
		FMAP 4K
		COREBOOT(CBFS)
		SMMSTORE(PRESERVE) 512K
	}
	RW_MRC_CACHE 256K
	PSP_NVRAM 128K
	UNUSED
	BPA(PRESERVE)@0x1B50000 320K
	PSP_RPMC_NVRAM 256K
	# ROMHOLE must be at flash offset 0x1BE0000
	ROMHOLE(PRESERVE)@0x1BE0000 128K
	BOOTSPLASH(CBFS)
	MSI_ID 4K
}
